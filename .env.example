DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://ehtiwaa_dev:changeme@localhost:5432/ehtiwaa_dev

# Cloud (S3-compatible) storage — off locally, required when USE_S3=True in staging/production
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@ehtiwaa.example

# Social login — the Google/Auth0 buttons on the signup/login pages only
# render once these are set. See docs/social-login-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Defaults to "Username-Password-Authentication" if unset — only needed if
# your Auth0 tenant's Database connection is named differently.
AUTH0_DB_CONNECTION=

# Google Calendar — creates a Meet link for each booking. A real Google
# account's OAuth credentials (not a service account — Meet auto-creation
# needs a real user). See docs/google-calendar-setup.md.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Optional — defaults to that account's own "primary" calendar if unset.
GOOGLE_CALENDAR_ID=

# Not wired up in this phase — reserved for when Celery/Redis background
# tasks (notifications, PDF generation, matching engine) are implemented.
CELERY_BROKER_URL=redis://localhost:6379/0

# Paymob (card payments — Visa/Mastercard) — the card option on checkout
# stays disabled (bank transfer only) until all four are set. See
# docs/paymob-setup.md.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
